@includeC("redbuild.h")
@includeC("syscalls/syscalls.h")

bool include_gpu() {
    if (not make_run("~/redlib","cross")) { return false; }
    if (not quick_cred("mesh.cred","mesh")){ return false; }
    source("obj.c");
    source("render.c");
    source("shaders.c");
    source("mesh.c");
    return true;
}

bool example {
    new_module("gpu");
    set_name("rend");
    
    //debug();
    
    set_package_type(package_red);
    set_target(target_native);
    
    if (not include_gpu()){ return false; }
    source("examples/mesh_load.c");
    
    if (compile()){
        gen_compile_commands(0);
        return run();
    }
    return false;
}

int main {
    defer emit_compile_commands();
    rebuild_self();
    example();
}